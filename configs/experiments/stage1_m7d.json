    "seed_policy": "e017_unseeded"
  },
  "subset": {
    "n": 16,
    "split": "train",
    "source": "data/manifests/m5_scaled_train_candidates.json",
    "selection": "ordered_ids prefix; no result-based resampling"
  },
  "cells": {
    "A": {
      "path": "standalone_eval",
      "lora": null,
      "group_n": 1
    },
    "B": {
      "path": "trainer_rollout",
      "lora": null,
      "group_n": 1
    },
    "C": {
      "path": "trainer_rollout",
      "lora": null,
      "group_n": 4
    },
    "D": {
      "path": "trainer_rollout",
      "lora": "fresh_zero_init",
      "group_n": 4,
      "checkpoint": null
    }
  },
  "thresholds": {
