{
  "schema_version": "bcrl-stage1-m7d-v1",
  "milestone": "M7D",
  "experiment_id": "M7D",
  "diagnostic_only": true,
  "eval_only": true,
  "not_training": true,
  "do_not_modify_e017_e018_m7c": true,
  "do_not_start_intervention": true,
  "no_optimizer_step": true,
